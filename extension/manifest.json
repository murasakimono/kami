{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "description": "__MSG_ext_desc__",
  "version": "0.8.6",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "downloads",
    "contextMenus",
    "nativeMessaging",
    "storage",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kami",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/alt_click.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "cloud_sites.js",
        "content/video_button.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/torrent_scan.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.yandex.ru/*",
        "*://*.yandex.com/*",
        "*://*.yandex.com.tr/*",
        "*://*.yandex.kz/*",
        "*://*.yandex.by/*",
        "*://*.yandex.uz/*",
        "*://yadi.sk/*",
        "*://cloud.mail.ru/*",
        "*://*.mediafire.com/*",
        "*://mega.nz/*",
        "*://*.mega.nz/*",
        "*://mega.co.nz/*",
        "*://mega.io/*",
        "*://drive.google.com/*",
        "*://*.dropbox.com/*",
        "*://pixeldrain.com/*",
        "*://pixeldrain.net/*",
        "*://pixeldra.in/*"
      ],
      "js": [
        "cloud_sites.js",
        "content/cloud_button.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
